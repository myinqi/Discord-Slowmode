# Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your-bot-token-here

# Discord application OAuth2 credentials for optional Suno Player account linking
DISCORD_CLIENT_ID=your-discord-application-client-id
DISCORD_CLIENT_SECRET=your-discord-application-client-secret

# Discord Guild (Server) ID
GUILD_ID=your-guild-id-here

# Web Interface Settings
WEB_HOST=0.0.0.0
WEB_PORT=5000
SECRET_KEY=change-this-to-a-random-secret-key

# Initial Admin Credentials (only used on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Database Path
DATABASE_PATH=data/bot.db

# Bot Display Name (shown in web interface)
BOT_NAME=Slowmode Bot

# TrYa Stream Whisper models. The full model is used only for the one-time
# retry when the regular transcript contains a known year hallucination.
TRYA_STREAM_WHISPER_MODEL=large-v3-turbo
TRYA_STREAM_WHISPER_RETRY_MODEL=large-v3
